# ── Kudeja Trading – Apache Configuration ──
# Handles SPA routing, security headers, caching, and compression.

# ━━━ 1. FORCE HTTPS ━━━
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ━━━ 2. SPA CLIENT-SIDE ROUTING ━━━
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If the file or directory physically exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't rewrite missing static assets (.js, .css, images, fonts) to index.html.
    # Serving index.html for a .js file causes "Unexpected token '<'" MIME syntax error and a white screen.
    RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|webp|pdf|map)$ [NC]
    RewriteRule ^ - [R=404,L]

    # Rewrite all remaining routes to /index.html for React Router
    RewriteRule ^ /index.html [L]
</IfModule>

# ━━━ 3. SECURITY HEADERS ━━━
<IfModule mod_headers.c>
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    # XSS protection
    Header set X-XSS-Protection "1; mode=block"
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Remove server signature
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ━━━ 4. GZIP / BROTLI COMPRESSION ━━━
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf
</IfModule>

# ━━━ 5. BROWSER CACHING ━━━
<IfModule mod_expires.c>
    ExpiresActive On
    # Hashed assets (Vite fingerprinted filenames) – aggressive cache
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    # Images
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/gif                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/avif               "access plus 1 year"
    # Fonts
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/ttf                 "access plus 1 year"
    # HTML – short cache so users always get latest SPA shell
    ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# ━━━ 6. DISABLE DIRECTORY LISTING ━━━
Options -Indexes

# ━━━ 7. BLOCK SENSITIVE FILES ━━━
<FilesMatch "\.(env|git|gitignore|yml|yaml|md|lock|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ━━━ 8. CUSTOM ERROR PAGES ━━━
ErrorDocument 404 /index.html
